    "codex:install": "node scripts/codex-install.mjs",
    "codex:e2e": "node codex-link/e2e.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  },
  "license": "MIT",
